{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "SkillServer": {
    "MaxConcurrentExecutions": 50,
    "DefaultTimeoutMs": 30000,
    "EnableMetrics": true,
    "EnableLogging": true
  },
  "Agents": {
    "DefaultQuotas": {
      "MaxExecutionsPerDay": 10000,
      "MaxConcurrentExecutions": 10,
      "RequestsPerMinute": 100
    }
  }
}
